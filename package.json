{
  "name": "procureflow-next",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node --env-file-if-exists=.env.local scripts/start.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings --react-plugin --nextjs-plugin --jsx-a11y-plugin src tests scripts",
    "test:e2e": "playwright test",
    "db:seed": "node --env-file=.env.local --import tsx scripts/seed.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postbuild": "node scripts/prepare-standalone.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.1",
    "@tanstack/react-query": "5.105.3",
    "better-sqlite3": "13.0.3",
    "clsx": "2.1.1",
    "lucide-react": "1.66.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "30.1.3",
    "oxlint": "1.90.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "type": "module"
}
